{
  "name": "sereneleeproperty",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  // Chat spam protection: each visitor (IP) can send up to 10 chat messages a minute.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Agent login: up to 5 password attempts a minute per IP.
    { "name": "LOGIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Private agent app records (door-knock log, contacts, appointments).
  "d1_databases": [
    { "binding": "DB", "database_name": "agent-app", "database_id": "50fb18a2-7149-4cc4-a55b-7b24132915e5" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
